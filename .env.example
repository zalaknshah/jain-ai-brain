# Optional local HTTP model adapter. Leave blank to use the deterministic reasoner.
JACE_LLM_URL=
JACE_LLM_API_KEY=
JACE_DB_PATH=data/jace.sqlite3
# Leave blank for the clearly labeled sample principles. External corpora require review metadata.
JACE_CANONICAL_PATH=
JACE_HOST=127.0.0.1
JACE_PORT=8787

# Required for HTTP access. JSON maps existing bearer tokens to user IDs.
# No tokens are generated automatically. Keep real values outside version control.
JACE_AUTH_TOKENS={}
JACE_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Local service limits, not a replacement for a production HTTPS gateway.
JACE_REQUEST_TIMEOUT_SECONDS=10
JACE_MAX_CONNECTIONS=16
JACE_RATE_PER_MINUTE=60
JACE_RATE_BURST=30
JACE_RATE_MAX_CLIENTS=1024
